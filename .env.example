# ==============================================================================
# MEDIA STORAGE CONFIGURATION (Persistent Volume / VPS Mount)
# ==============================================================================
# Runtime CMS uploads are written to disk and served via /api/admin/media/[id].
# In ephemeral container/VPS deployments (e.g. Hostinger Docker, persistent disk mounts),
# set this to an absolute path pointing to an attached persistent volume.
# If left empty, defaults to workspace path: ./storage/media
# Example for production Linux VPS:
# MEDIA_STORAGE_DIR="/var/data/geeta-university/media"
MEDIA_STORAGE_DIR=""
