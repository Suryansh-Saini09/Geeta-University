DATABASE_URL="mysql://MYSQL_USER:MYSQL_PASSWORD@MYSQL_HOST:3306/geeta_university"
ADMIN_SESSION_DAYS="7"
GEETA_LEAD_API_URL="https://geetauniversity.com/Rapi/form/insert"
GEETA_LEAD_API_KEY="your-lead-ingestion-api-key"
SEED_ADMIN_NAME="Suryansh Admin"
SEED_ADMIN_EMAIL="admin@geetauniversity.local"
SEED_ADMIN_PASSWORD="change-this-long-password"

# ==============================================================================
# MEDIA STORAGE CONFIGURATION
# ==============================================================================
# Choose either 's3' (recommended for Hostinger Object Storage / S3 / R2) or 'local' (persistent volume/disk).
MEDIA_STORAGE_DRIVER="local"

# OPTION 1: S3-Compatible Object Storage (Hostinger Object Storage, Cloudflare R2, AWS S3, MinIO)
MEDIA_STORAGE_BUCKET="geeta-media-bucket"
MEDIA_STORAGE_REGION="us-east-1"
MEDIA_STORAGE_ENDPOINT="https://s3.region.hostinger.com"
MEDIA_STORAGE_ACCESS_KEY="your-storage-access-key"
MEDIA_STORAGE_SECRET_KEY="your-storage-secret-key"
MEDIA_STORAGE_FORCE_PATH_STYLE="true"
# Optional CDN or public custom domain for direct serving:
# MEDIA_STORAGE_PUBLIC_URL="https://media.geetauniversity.edu.in"

# OPTION 2: Persistent Local Filesystem (Hostinger VPS / Persistent Directory outside build tree)
# Set this to an absolute path outside git/hbuilds that survives deployments.
# E.g. for Hostinger VPS / Linux: "/home/u232028417/media_storage"
# If left empty in dev, defaults to: ./storage/media
MEDIA_STORAGE_ROOT=""
MEDIA_STORAGE_DIR=""

# Upload Size Limits (in bytes)
MEDIA_MAX_IMAGE_BYTES="15728640"      # 15 MB
MEDIA_MAX_DOCUMENT_BYTES="31457280"   # 30 MB
